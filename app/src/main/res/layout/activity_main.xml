<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_login_background" />

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <androidx.cardview.widget.CardView
        android:id="@+id/logoContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:layout_centerHorizontal="true"
        app:cardCornerRadius="60dp"
        app:cardElevation="10dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:background="@android:color/white"
            android:src="@drawable/img_app_logo"/> </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_below="@id/logoContainer"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-black"
        android:text="DriveCoach"
        android:textColor="@android:color/white"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@id/appTitle"
        android:layout_centerHorizontal="true"
        android:text="Your personal driving companion"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:layout_marginHorizontal="32dp" >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstructorLogin"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="16dp"
            android:text="Instructor Login"
            android:textSize="18sp"
            android:textStyle="bold"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:backgroundTint="#829FFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentLogin"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Student Login"
            android:textSize="18sp"
            android:textStyle="bold"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:backgroundTint="#829FFF" />

    </LinearLayout>

</RelativeLayout>