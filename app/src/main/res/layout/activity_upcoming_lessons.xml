<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    android:layoutDirection="ltr"
    tools:context=".activity.activityInstructor.UpcomingLessonsActivity">

    <TextView
        android:id="@+id/tvUpcomingLessonsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Upcoming Lessons"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUpcomingLessons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvUpcomingLessonsTitle"
        tools:listitem="@layout/item_upcoming_lesson" />

    <TextView
        android:id="@+id/tvNoLessonsWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No upcoming lessons scheduled."
        android:textColor="#666666"
        android:textSize="16sp"
        android:visibility="gone" />

</RelativeLayout>